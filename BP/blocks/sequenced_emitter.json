{
	"format_version": "1.26.0",
	"minecraft:block": {
		"description": {
			"identifier": "vc:sequenced_emitter",
			"menu_category": {
				"category": "items"
			},
			"states": {
				"vc:lit": [
					false,
					true
				]
			},
			"traits": {
				"minecraft:placement_direction": {
					"enabled_states": [
						"minecraft:cardinal_direction"
					],
					"y_rotation_offset": 180
				}
			}
		},
		"components": {
			"minecraft:flammable": true,
			"minecraft:geometry": "minecraft:geometry.full_block",
			"minecraft:map_color": "#C87456",
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 15
			},
			"minecraft:redstone_producer": {
			  	"power": 0,
			  	"strongly_powered_face": "north",
				"connected_faces": ["north"],
			  	"transform_relative": true
			},
			"minecraft:tick": {
				"interval_range": [
					1,
					1
				],
				"looping": true
			},
			"minecraft:item_visual": {
				"geometry": "minecraft:geometry.full_block",
					"material_instances": {
					"*": {
						"texture": "vc_sequenced_emitter"
					},
					"north": {
						"texture": "vc_sequenced_emitter_front"
					},
					"south": {
						"texture": "vc_sequenced_emitter_front"
					}
				}
			},
			"minecraft:material_instances": {
				"*": {
					"texture": "vc_sequenced_emitter"
				},
				"north": {
					"texture": "vc_sequenced_emitter_front"
				}
			}
		},
		"permutations": [
			{
				"condition": "query.block_state('vc:lit') == false",
				"components": {
					"minecraft:redstone_producer": {
					  	"power": 0,
					  	"strongly_powered_face": "north",
						"connected_faces": ["north"],
					  	"transform_relative": true
					},
					"minecraft:material_instances": {
						"*": {
							"texture": "vc_sequenced_emitter"
						},
						"north": {
							"texture": "vc_sequenced_emitter_front"
						}
					}
				}
			},
			{
				"condition": "query.block_state('vc:lit') == true",
				"components": {
					"minecraft:redstone_producer": {
					  	"power": 15,
					  	"strongly_powered_face": "north",
						"connected_faces": ["north"],
					  	"transform_relative": true
					},
					"minecraft:material_instances": {
						"*": {
							"texture": "vc_sequenced_emitter"
						},
						"north": {
							"texture": "vc_sequenced_emitter_front_on"
						}
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							180,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							270,
							0
						]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [
							0,
							90,
							0
						]
					}
				}
			}
		]
	}
}